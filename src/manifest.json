{
  "name": "Domain Time Tracker",
  "description": "to come in future",
  "version": "1.0.0",
  "manifest_version": 3,
  "permissions": ["storage", "tabs", "idle", "alarms", "notifications"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "settings.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "domain-tracker@yourdomain.com"
    }
  }
}