{
  "name": "BrainSoap",
  "description": "A browser extension to help users manage their time spent on distracting websites by providing customizable blocking and redirection features.",
  "version": "1.0.0",
  "manifest_version": 3,
  "permissions": ["storage", "tabs", "idle", "alarms", "notifications"],
  "icons": {
    "16":  "assets/icons/icon16.png",
    "32":  "assets/icons/icon32.png",
    "48":  "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "background": {
    "scripts": [
      "src/utils/utils.js",
      "src/utils/defaults.js",
      "src/browser_handlers/storage_manager.js",
      "src/background/background.js"
    
    ]
  },
  "action": {
    "default_popup": "src/quick_page/popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "BrainSoap@yourdomain.com"
    }
  }
}

